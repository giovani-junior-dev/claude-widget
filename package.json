{
  "name": "claude-widget",
  "version": "1.1.0",
  "private": true,
  "description": "Widget de desktop que mostra o consumo de Claude Code, Codex, Kimi Code e Grok Build",
  "author": "Giovani Junior",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "preparar": "electron --version",
    "test": "node --test",
    "icons": "node tools/make-icons.js",
    "autostart:on": "electron tools/autostart-cli.js --on",
    "autostart:off": "electron tools/autostart-cli.js --off",
    "autostart:status": "electron tools/autostart-cli.js --status",
    "empacotar": "node tools/pack.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.giovanijunior.claude-widget",
    "productName": "Claude Widget",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "lib/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "publish": {
      "provider": "github",
      "owner": "giovani-junior-dev",
      "repo": "claude-widget",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
